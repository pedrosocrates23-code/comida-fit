---
// ───────────────────────────────────────────────────────────────
// TaxonomyNav — links de navegação por tipo / categoria / marca
// Estática, indexável, sem URLs facetadas (cada link → página própria)
// ───────────────────────────────────────────────────────────────
import {
  TIPOS,
  CATEGORIAS,
  MARCAS,
  listTiposComProdutos,
  listCategoriasComProdutos,
  listMarcasComProdutos,
  listAsinsByTipo,
  listAsinsByCategoria,
  listAsinsByMarca,
} from '@data/produto-taxonomy';

interface Props {
  /** Slug ativo (destacado na nav). Ex.: { tipo: 'suplemento' } */
  active?: { tipo?: string; categoria?: string; marca?: string };
  /** Quando true, oculta a seção de marcas (lista grande). */
  compact?: boolean;
}

const { active = {}, compact = false } = Astro.props;

const tipos      = listTiposComProdutos();
const categorias = listCategoriasComProdutos();
const marcas     = listMarcasComProdutos();
---

<nav class="taxonomy-nav" aria-label="Filtrar produtos">
  <div class="taxonomy-section">
    <h2 class="taxonomy-label">Tipo</h2>
    <ul class="taxonomy-pills">
      <li>
        <a
          href="/produtos/"
          class={`pill ${!active.tipo && !active.categoria && !active.marca ? 'pill--active' : ''}`}
        >
          Todos
        </a>
      </li>
      {tipos.map((tipo) => (
        <li>
          <a
            href={`/produtos/tipo/${tipo}/`}
            class={`pill ${active.tipo === tipo ? 'pill--active' : ''}`}
          >
            {TIPOS[tipo].label}
            <span class="pill-count">{listAsinsByTipo(tipo).length}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="taxonomy-section">
    <h2 class="taxonomy-label">Categoria</h2>
    <ul class="taxonomy-pills">
      {categorias.map((cat) => (
        <li>
          <a
            href={`/produtos/categoria/${cat}/`}
            class={`pill ${active.categoria === cat ? 'pill--active' : ''}`}
          >
            {CATEGORIAS[cat].label}
            <span class="pill-count">{listAsinsByCategoria(cat).length}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  {!compact && (
    <details class="taxonomy-section taxonomy-section--collapsible">
      <summary class="taxonomy-label">Marca <span class="taxonomy-count">({marcas.length})</span></summary>
      <ul class="taxonomy-pills">
        {marcas.map((m) => (
          <li>
            <a
              href={`/produtos/marca/${m}/`}
              class={`pill pill--marca ${active.marca === m ? 'pill--active' : ''}`}
            >
              {MARCAS[m].label}
              <span class="pill-count">{listAsinsByMarca(m).length}</span>
            </a>
          </li>
        ))}
      </ul>
    </details>
  )}
</nav>

<style>
  .taxonomy-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-4);
    border: var(--border);
    background: var(--color-surface);
    margin-bottom: var(--space-6);
  }

  .taxonomy-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .taxonomy-section--collapsible > summary {
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .taxonomy-section--collapsible > summary::-webkit-details-marker { display: none; }
  .taxonomy-section--collapsible > summary::before {
    content: '▸ ';
    font-size: 0.7em;
    transition: transform var(--transition);
    display: inline-block;
  }
  .taxonomy-section--collapsible[open] > summary::before { transform: rotate(90deg); }

  .taxonomy-label {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    margin: 0;
  }

  .taxonomy-count {
    font-weight: 400;
    color: var(--color-muted);
    font-size: 0.85em;
  }

  .taxonomy-pills {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    background: var(--color-canvas);
    border: 2px solid #1a1a1a;
    box-shadow: 2px 2px 0 #1a1a1a;
    color: var(--color-ink);
    text-decoration: none !important;
    font-size: var(--text-sm);
    font-weight: 600;
    transition: box-shadow var(--transition), transform var(--transition);
  }

  .pill:hover {
    box-shadow: 4px 4px 0 #1a1a1a;
    transform: translate(-1px, -1px);
  }

  .pill--active {
    background: var(--color-secondary);
    color: #fff !important;
  }

  .pill--marca {
    font-size: var(--text-xs);
    padding: 0.25rem 0.55rem;
  }

  .pill-count {
    font-size: 0.7rem;
    background: rgba(0, 0, 0, 0.08);
    padding: 0.05rem 0.35rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .pill--active .pill-count {
    background: rgba(255, 255, 255, 0.25);
  }

  @media (max-width: 640px) {
    .taxonomy-nav { padding: var(--space-3); gap: var(--space-3); }
    .pill { font-size: var(--text-xs); padding: 0.3rem 0.55rem; }
  }
</style>
