---
import BaseLayout    from '@layouts/BaseLayout.astro';
import Header        from '@components/Header.astro';
import Footer        from '@components/Footer.astro';
import Breadcrumb    from '@components/Breadcrumb.astro';
import ProdutoGrid   from '@components/ProdutoGrid.astro';
import TaxonomyNav   from '@components/TaxonomyNav.astro';
import { loadAllProdutos, sortProdutos } from '@utils/produto-loader';
import { TIPOS, listTiposComProdutos, type ProdutoTipo } from '@data/produto-taxonomy';

export async function getStaticPaths() {
  return listTiposComProdutos().map((tipo) => ({ params: { tipo } }));
}

const { tipo } = Astro.params as { tipo: ProdutoTipo };
const meta = TIPOS[tipo];

const all = await loadAllProdutos();
const filtrados = sortProdutos(all.filter((e) => e.taxonomia?.tipo === tipo));

const breadcrumbs = [
  { name: 'Home',      url: 'https://melhoresreceitasfit.com.br/' },
  { name: 'Produtos',  url: 'https://melhoresreceitasfit.com.br/produtos/' },
  { name: meta.label,  url: `https://melhoresreceitasfit.com.br/produtos/tipo/${tipo}/` },
];
---

<BaseLayout
  title={`${meta.label} — Melhores Produtos Fitness`}
  description={`${meta.descricao} ${filtrados.length} produtos avaliados com dados reais de compradores.`}
  type="website"
  canonicalUrl={`https://melhoresreceitasfit.com.br/produtos/tipo/${tipo}/`}
>
  <Header />

  <main id="main-content">
    <div class="container">
      <Breadcrumb items={breadcrumbs} />

      <header class="page-header">
        <h1 class="page-title">{meta.label}</h1>
        <p class="page-desc">
          {meta.descricao} <strong>{filtrados.length} produtos</strong> avaliados.
        </p>
      </header>

      <TaxonomyNav active={{ tipo }} />

      <ProdutoGrid produtos={filtrados} emptyMessage={`Nenhum produto cadastrado em ${meta.label}.`} />
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-header {
    padding-block: var(--space-8);
    border-bottom: var(--border);
    margin-bottom: var(--space-6);
  }
  .page-title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    margin-bottom: var(--space-2);
  }
  .page-desc {
    font-size: var(--text-lg);
    color: var(--color-muted);
    line-height: 1.6;
    max-width: 65ch;
  }
  @media (max-width: 640px) {
    .page-header { padding-block: var(--space-5); }
    .page-title { font-size: var(--text-2xl); margin-bottom: var(--space-1); }
    .page-desc { font-size: var(--text-base); }
  }
</style>
