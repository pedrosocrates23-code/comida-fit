---
import BaseLayout    from '@layouts/BaseLayout.astro';
import Header        from '@components/Header.astro';
import Footer        from '@components/Footer.astro';
import Breadcrumb    from '@components/Breadcrumb.astro';
import ProdutoGrid   from '@components/ProdutoGrid.astro';
import TaxonomyNav   from '@components/TaxonomyNav.astro';
import { loadAllProdutos, sortProdutos } from '@utils/produto-loader';

const allProdutos = sortProdutos(await loadAllProdutos());

const SITE = 'https://melhoresreceitasfit.com.br';
const PAGE_URL = `${SITE}/produtos/`;
const PAGE_TITLE = 'Produtos Fitness — Suplementos, Equipamentos e Acessórios';
const PAGE_DESCRIPTION = 'Compare os melhores produtos fitness com avaliações reais de compradores: suplementos, equipamentos e acessórios com preços atualizados e entrega rápida.';

const breadcrumbs = [
  { name: 'Home',     url: `${SITE}/` },
  { name: 'Produtos', url: PAGE_URL },
];

// ── Structured Data ───────────────────────────────────────
const collectionPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: PAGE_TITLE,
  description: PAGE_DESCRIPTION,
  url: PAGE_URL,
  inLanguage: 'pt-BR',
  isPartOf: {
    '@type': 'WebSite',
    name: 'Melhores Receitas Fit',
    url: SITE,
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    item: b.url,
  })),
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: PAGE_TITLE,
  numberOfItems: allProdutos.length,
  itemListOrder: 'https://schema.org/ItemListOrderDescending',
  itemListElement: allProdutos.map(({ produto, slug }, i) => {
    const productUrl = `${SITE}/produtos/${slug}/`;
    const product: Record<string, any> = {
      '@type': 'Product',
      name: produto.titulo,
      url: productUrl,
      sku: produto.asin,
    };
    if (produto.imagem)   product.image = produto.imagem;
    if (produto.vendedor) product.brand = { '@type': 'Brand', name: produto.vendedor };
    if (produto.rating && produto.ratingCount) {
      product.aggregateRating = {
        '@type': 'AggregateRating',
        ratingValue: produto.rating,
        reviewCount: produto.ratingCount,
        bestRating: 5,
        worstRating: 1,
      };
    }
    if (produto.preco != null) {
      product.offers = {
        '@type': 'Offer',
        priceCurrency: 'BRL',
        price: produto.preco.toFixed(2),
        availability: 'https://schema.org/InStock',
        url: productUrl,
      };
    }
    return {
      '@type': 'ListItem',
      position: i + 1,
      url: productUrl,
      item: product,
    };
  }),
};

const pageSchema = [collectionPageSchema, breadcrumbSchema, itemListSchema];
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESCRIPTION}
  type="website"
  canonicalUrl={PAGE_URL}
  schema={pageSchema}
>
  <Header />

  <main id="main-content">
    <div class="container">
      <Breadcrumb items={breadcrumbs} />

      <header class="page-header">
        <h1 class="page-title">Produtos Fitness</h1>
        <p class="page-desc">
          <strong>{allProdutos.length} produtos</strong> avaliados com dados reais de compradores.
          Suplementos, equipamentos e acessórios — clique em qualquer item para ver especificações completas e o melhor preço.
        </p>
      </header>

      <TaxonomyNav />

      <ProdutoGrid produtos={allProdutos} />
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-header {
    padding-block: var(--space-8);
    border-bottom: var(--border);
    margin-bottom: var(--space-6);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    margin-bottom: var(--space-2);
  }

  .page-desc {
    font-size: var(--text-lg);
    color: var(--color-muted);
    line-height: 1.6;
    max-width: 65ch;
  }

  @media (max-width: 640px) {
    .page-header { padding-block: var(--space-5); }
    .page-title { font-size: var(--text-2xl); margin-bottom: var(--space-1); }
    .page-desc { font-size: var(--text-base); }
  }
</style>
